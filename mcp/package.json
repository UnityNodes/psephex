{
  "name": "@psephex/mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MCP server that lets an AI agent use the Psephex court on NEAR: open and answer cases, check payments, verdicts and reputation",
  "bin": {
    "psephex-mcp": "dist/src/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "node dist/src/main.js"
  },
  "engines": {
    "node": ">=22.12"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "near-api-js": "7.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
