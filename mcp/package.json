{
  "name": "@unitynodes/psephex-mcp",
  "version": "0.1.0",
  "mcpName": "io.github.UnityNodes/psephex",
  "description": "MCP server that lets an AI agent use the Psephex court on NEAR: open and answer cases, check payments, verdicts and reputation",
  "keywords": [
    "mcp",
    "near",
    "ai-agents",
    "x402",
    "arbitration",
    "oracle"
  ],
  "homepage": "https://psephex.xyz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UnityNodes/psephex.git",
    "directory": "mcp"
  },
  "type": "module",
  "bin": {
    "psephex-mcp": "dist/src/main.js"
  },
  "files": [
    "dist/src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "node dist/src/main.js",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "engines": {
    "node": ">=22.12"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "near-api-js": "7.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "borsh": "2.0.0",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
